# MongoDB Configuration
# Replace with your MongoDB Atlas or local MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ticket_management?retryWrites=true&w=majority

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
# Change this secret key in production to a secure random string
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRY=7d

# CORS Configuration
# Set this to your frontend application's base URL (e.g. localhost, Vercel URL)
FRONTEND_URL=http://localhost:5173
